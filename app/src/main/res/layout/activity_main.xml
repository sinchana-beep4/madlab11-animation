<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="@color/sunshine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="25sp"
        android:textAlignment="center"
        android:padding="10dp"
        android:textStyle="bold"
        android:textColor="@color/dark_green"
        android:text="@string/we_are_learning_animations_today_yipee"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/fade_in"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text="@string/fade_in"
        android:backgroundTint="@color/sage_green"
        android:layout_marginLeft="20dp"
        android:layout_marginBottom="10dp"
        android:textColor="@color/white"
        app:layout_constraintBottom_toTopOf="@+id/zoom_in"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/fade_out"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text="@string/fade_out"
        android:textColor="@color/white"
        android:backgroundTint="@color/sage_green"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@+id/zoom_out"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/zoom_in"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text="@string/zoom_in"
        android:textColor="@color/white"
        android:backgroundTint="@color/sage_green"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@+id/slide_down"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/slide_up"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text="@string/slide_up"
        android:textColor="@color/white"
        android:backgroundTint="@color/sage_green"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@+id/bounce"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/bounce"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text="@string/bounce"
        android:textColor="@color/white"
        android:backgroundTint="@color/sage_green"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/zoom_out"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text="@string/zoom_out"
        android:textColor="@color/white"
        android:backgroundTint="@color/sage_green"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@+id/slide_down"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/slide_down"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text="@string/slide_down"
        android:textColor="@color/white"
        android:backgroundTint="@color/sage_green"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@+id/rotate"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/rotate"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text="@string/rotate"
        android:textColor="@color/white"
        android:backgroundTint="@color/sage_green"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>